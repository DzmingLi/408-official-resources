// 采用2路归并的思想实现

```c
int M_Search( int A[ ], int B[ ], int n)
{
    int i, j, k;
    i = j = k = 0;
    while( i < n && j < n )
    {
        k++ ;
        if ( A[i] < B[j] )
        {
            i++ ;
            if( k == n ) return A[i - 1] ;
        }
        else
        {
            j++ ;
            if( k == n ) return B[j - 1] ;
        }
    }
}
```

